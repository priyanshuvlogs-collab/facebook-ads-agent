# ---- Meta (Facebook) Marketing API credentials ----
# Get these from https://developers.facebook.com/ (create an app with Marketing API access)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=
META_API_VERSION=v21.0

# Optional: Instagram actor id if you also run ads on Instagram placements
META_INSTAGRAM_ACTOR_ID=

# ---- Optional: LLM for AI ad copy (falls back to built-in templates if unset) ----
# Supported providers: openai, anthropic
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ---- Optional: lead delivery integrations ----
# Any webhook that accepts JSON POSTs (Zapier, Make, n8n, your CRM endpoint...)
LEAD_WEBHOOK_URL=
# Slack incoming webhook for alerts and daily digests
SLACK_WEBHOOK_URL=

# ---- Agent behaviour ----
# true = simulate everything locally, never call the real API (safe default)
DRY_RUN=true
# Directory where agent state, leads and reports are written
AGENT_HOME=.state

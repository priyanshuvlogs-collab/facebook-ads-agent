{
  "name": "@yta/api",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hunter:run": "tsx src/scripts/run-hunter.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@yta/ai-providers": "*",
    "@yta/api-hunter": "*",
    "@yta/database": "*",
    "@yta/shared": "*",
    "@yta/youtube-core": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

# ============================================================
# YouTube Automation Agent - Environment Configuration
# Copy this file to .env and fill in the values you have.
# Everything degrades gracefully: modules that lack keys are
# disabled at runtime instead of crashing the system.
# ============================================================

# --- Database (required) ------------------------------------
# Local dev: docker compose up -d postgres
DATABASE_URL="postgresql://yta:yta@localhost:5432/yta?schema=public"

# --- Free API Hunter ----------------------------------------
# A GitHub personal access token (classic, no scopes needed for
# public data) raises the search rate limit from 10 -> 30 req/min
# and the core limit from 60 -> 5000 req/hour. Strongly recommended.
GITHUB_TOKEN=""

# --- AI providers (at least one recommended) -----------------
# The system picks the first configured provider by priority,
# and falls back to the next one on failure.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
TOGETHER_API_KEY=""

# --- Text-to-speech ------------------------------------------
# OpenAI TTS is used if OPENAI_API_KEY is set. ElevenLabs is
# used if this key is set (takes priority for voice quality).
ELEVENLABS_API_KEY=""

# --- Stock footage / images (free tiers) ---------------------
PEXELS_API_KEY=""

# --- YouTube publishing (OAuth2) ------------------------------
# Create OAuth credentials at https://console.cloud.google.com
# and obtain a refresh token with the youtube.upload scope.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""

# --- Servers --------------------------------------------------
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
LOG_LEVEL="info"
